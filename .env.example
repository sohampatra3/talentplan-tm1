# Required: pooled Neon PostgreSQL URL; keep all credentials on the server.
DATABASE_URL=
# Direct URL is used only by db:setup. Falls back to DATABASE_URL if not set.
DATABASE_URL_UNPOOLED=
# Required in production for signed anonymous scenario sessions.
SESSION_SECRET=
# Optional AI credentials. Without keys the app offers labelled deterministic analysis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-sol
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# Paid AI is disabled on public demo until this access token is configured.
# Presenter enters this token in Copilot; it is never stored in browser storage.
COPILOT_ACCESS_TOKEN=
# Optional private deployment access password. Required when real TM1 is configured.
APP_ACCESS_PASSWORD=
# Optional TM1. Trusted server configuration only; no arbitrary URLs from users.
TM1_URL=
TM1_USER=
TM1_PASSWORD=
TM1_API_KEY=
TM1_MDX=
TM1_CUBE=Finance_Plan
